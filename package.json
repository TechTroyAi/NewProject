{
  "name": "shelf",
  "version": "0.1.0",
  "private": true,
  "description": "Shelf \u2014 a reading + notes + AI shelf. Drop anything, read it, think about it, remember it.",
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @shelf/web",
    "build": "npm run build --workspace @shelf/web",
    "start": "npm run start --workspace @shelf/web",
    "lint": "npm run lint --workspace @shelf/web",
    "typecheck": "npm run typecheck --workspace @shelf/web && npm --prefix apps/worker run typecheck",
    "worker:dev": "npm --prefix apps/worker run dev",
    "test": "node --import tsx --test tests/*.test.ts",
    "worker:build": "docker build -t shelf-worker apps/worker"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "next": "^14.2.35"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}
