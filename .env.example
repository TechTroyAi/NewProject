# ─── Supabase ────────────────────────────────────────────────
# Leave these unset to run Shelf in DEMO MODE (seeded data, no infra).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── Storage (Cloudflare R2 / S3 / Supabase Storage) ─────────
# Point page images + originals at a public bucket with a CDN prefix,
# or leave blank in demo mode.
NEXT_PUBLIC_MEDIA_BASE_URL=

# ─── AI ──────────────────────────────────────────────────────
# Leave blank to use the built-in mock provider (deterministic replies).
#
# The first provider with a key wins:
#     Gemini  ->  OpenAI  ->  Anthropic  ->  Ollama
#
# Google AI Studio now issues "Auth keys" that start with AQ.
# (the legacy format was AIza...). Auth keys are sent in the
# x-goog-api-key header, not as a bearer token — Shelf handles that.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1
AI_MODEL=openai/gpt-4o-mini

# ─── OAuth (Supabase social login) ───────────────────────────
# Comma-separated list of providers Shelf offers buttons for:
#     NEXT_PUBLIC_OAUTH_PROVIDERS=google,github
# Leave unset to offer both. A button only renders when the provider is
# listed here *and* enabled in Supabase Auth > Providers (the app detects
# that at runtime from /auth/v1/settings).
NEXT_PUBLIC_OAUTH_PROVIDERS=

# ─── Secrets ─────────────────────────────────────────────────
# 32 bytes, hex (64 chars) or base64. Used to encrypt the keys a
# user brings their own — without it the feature is switched off.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SHELL_ENCRYPTION_KEY=

# ─── Rate limiting ───────────────────────────────────────────
# Optional. Without these, limits are enforced in-process.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Worker ─────────────────────────────────────────────────
WORKER_CALLBACK_SECRET=

# ─── Public source catalogue ─────────────────────────────────
# Shelf reads the Mihon/Tachiyomi extension index from the public
# keiyoushi/extensions repository. A token is optional — it only
# raises the GitHub API rate limit (60/h unauthenticated).
GITHUB_TOKEN=

# If your network uses a TLS-inspecting proxy, point Node at the
# extra CA bundle so the catalogue fetch can be verified.
# NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
